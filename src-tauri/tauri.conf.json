{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Clipboard",
  "version": "1.0.0",
  "identifier": "dev.nexus.clipboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus Clipboard",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Nexus",
    "category": "Productivity",
    "shortDescription": "A fast, private clipboard manager",
    "longDescription": "Nexus Clipboard keeps a searchable history of everything you copy — text, links, code, images and files — entirely on your machine. Instant search across millions of items, smart content detection, encrypted storage for credentials, and a global hotkey that pastes straight back into whatever you were working in.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "section": "utils"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator3",
          "librsvg2"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
